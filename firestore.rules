rules_version = '2';

// まなび道場 - Firestore セキュリティルール
// Firebaseコンソール → Databases & Storage → Firestore → Rules タブに
// この内容をそのまま貼り付けて「公開（Publish）」してください。
//
// 前提: Authentication で「匿名（Anonymous）」ログインを有効にしていること。
// このアプリは request.auth の有無だけを見ており、個人を特定する認証は
// 行っていません（家族内での利用を想定した、緩い保護です）。

service cloud.firestore {
  match /databases/{database}/documents {

    // みんなの記録（プロフィール名がそのままドキュメントID）
    match /leaderboard/{profileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.resource.data.name == profileName
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.streakCount is int
        && request.resource.data.perfectCount is int
        && request.resource.data.totalCorrect is int
        && request.resource.data.badgeCount is int;
    }

    // 応援スタンプ（送信のみ許可。改ざん防止のため更新・削除は不可）
    match /cheers/{cheerId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() <= 20
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0
        && request.resource.data.from.size() <= 20
        && request.resource.data.emoji in ['🎉', '👍', '🔥', '💪', '😊', '⭐']
        && request.resource.data.sentAt == request.time;

      allow update, delete: if false;
    }

    // ギルド週間ポイントランキング（ドキュメントID = "プロフィール名_週キー"）
    match /guildWeekly/{entryId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.weekKey is string
        && request.resource.data.weekKey.size() == 10
        && request.resource.data.points is int
        && request.resource.data.rank is string;
    }

    // 闘技場ランキング（ドキュメントID = "プロフィール名_制限時間キー"）
    // プロフィールごとに、その制限時間での自己ベスト1件だけを保持する想定。
    match /arenaRanking/{entryId} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.timeLimitKey in ['1min', '3min']
        && request.resource.data.correctCount is int
        && request.resource.data.subject is string
        && request.resource.data.grade is string;
    }

    // 文明の塔の踏破記録（送信のみ許可。改ざん防止のため更新・削除は不可）
    match /towerConquests/{entryId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.subject is string
        && request.resource.data.difficulty is string
        && request.resource.data.reachedFloor is int
        && request.resource.data.achievedAt == request.time;

      allow update, delete: if false;
    }

    // できごとタイムライン（バッジ獲得・塔踏破・闘技場自己ベストを自動投稿）
    match /familyFeed/{entryId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.profile is string
        && request.resource.data.profile.size() > 0
        && request.resource.data.profile.size() <= 20
        && request.resource.data.kind in ['badge', 'tower', 'arena']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.highlighted == false
        && request.resource.data.createdAt == request.time;

      // ハイライトのON操作のみ許可し、それ以外のフィールドの改ざんは防ぐ
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['highlighted'])
        && request.resource.data.highlighted == true;

      allow delete: if false;
    }

    // できごとタイムラインへのリアクション（送信のみ許可）
    match /feedReactions/{reactionId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.entryId is string
        && request.resource.data.entryId.size() > 0
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0
        && request.resource.data.from.size() <= 20
        && request.resource.data.emoji in ['🎉', '👍', '🔥', '💪', '😊', '⭐', '🏆', '👑', '🙌']
        && request.resource.data.sentAt == request.time;

      allow update, delete: if false;
    }

    // 上記以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
